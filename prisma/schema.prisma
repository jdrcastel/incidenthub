// Prisma schema: your database tables described as models.
// After changing it, run `npm run db:migrate` to create a SQL migration
// and regenerate the typed client.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

